APP_NAME=lecxe-chatbot
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Secret for signing JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Agent (Layer 5). Backend only: never put the OpenAI key in frontend env files.
OPENAI_API_KEY=
# An OpenAI model with tool calling, e.g. gpt-5.4-mini
AGENT_MODEL=
AGENT_MAX_ITERATIONS=12
# Semantic retrieval (Layer 6); reuses OPENAI_API_KEY. One of the models the openai package declares.
EMBEDDING_MODEL=text-embedding-3-small
# Minimum cosine similarity (0-1) for a semantic search result to be returned.
RAG_SIMILARITY_THRESHOLD=0.3
# LangSmith tracing (Layer 16). Off unless true. Traces carry structure, timing, status and token
# usage only: run inputs and outputs (messages, prompts, tool arguments and results) are never sent.
# Backend only: never put the LangSmith key in frontend env files.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lecxe-chatbot
